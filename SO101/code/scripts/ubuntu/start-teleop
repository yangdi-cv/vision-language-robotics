#!/usr/bin/env bash
set -euo pipefail
SO101_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd)"
teleop_args=("$SO101_ROOT/code/scripts/ubuntu/project-python" "$SO101_ROOT/code/scripts/teleop_table_lerobot.py"
  --leader-port /dev/serial/by-id/usb-1a86_USB_Single_Serial_5CE5121669-if00
  --follower-port /dev/serial/by-id/usb-1a86_USB_Single_Serial_5CE5122996-if00 "$@")
printf -v teleop_command '%q ' "${teleop_args[@]}"
exec sg dialout -c "exec $teleop_command"
